# ==================================================
# LOCAL CONFIGURATION (ZERO-COST, NO API KEYS)
# ==================================================
VECTOR_STORE=faiss
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# RAG CONFIGURATION
TOP_K=5
RELEVANCE_THRESHOLD=0.65
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ==================================================
# OPTIONAL CLOUD CONFIGURATION (OPENAI + PINECONE)
# ==================================================
# To use cloud providers, change:
# VECTOR_STORE=pinecone
# EMBEDDING_PROVIDER=openai
# LLM_PROVIDER=openai
# and provide the keys below:
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentic-ai-index
PINECONE_NAMESPACE=default
